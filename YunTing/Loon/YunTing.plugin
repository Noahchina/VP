[Script]
# > 云听-全国电台有声书解锁会员
response if ${url} ~= /(^https?:\/\/(ytmsout|ytapi|getway)\.radio\.cn|60\.205\.171\.165)\/(contentBiz|publish|rights|(user|ytsrv\/srv)\/(appUser|webPage)\/getUserInfo|app.+)/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/YunTing.js") with tag="云听-全国电台有声书解锁会员", timeout=60, requires_body=true
response if ${url} ~= /^https:\/\/ytmsout\.radio\.cn\/resourceConnector\/connector\/getByPage/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/yunting_ad.js") with requires_body=true

[MITM]
hostname = *.radio.cn, 60.205.171.165
